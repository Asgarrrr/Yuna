{
  "name": "bunrift",
  "version": "0.1.0",
  "description": "A modern, production-ready starter template with Next.js 16 Canary, Better Auth, PostgreSQL via Drizzle ORM, and Biome for linting and formatting.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "drizzle:generate": "bunx --bun drizzle-kit generate --config src/lib/db/drizzle.config.ts",
    "drizzle:push": "bunx --bun drizzle-kit push --config src/lib/db/drizzle.config.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.4.16",
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "better-auth": "^1.4.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.562.0",
    "next": "16.1.4",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bun": "^1.3.6",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.8",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
